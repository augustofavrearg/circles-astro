# Use "fixtures" until the project is linked to Wix and the CMS collections exist.
CONTENT_SOURCE=fixtures

# Fail-closed SEO policy. Development, previews and Wix technical hosts remain
# noindex unless both values are deliberately changed for the final launch.
SEO_ALLOW_INDEXING=false
# Required only when SEO_ALLOW_INDEXING=true. It must be an HTTPS origin with
# no path, query or fragment, for example https://www.circles.house.
SITE_URL=

# Optional guard used by the Cloudbeds redirect adapter. Set this to the exact
# origin used by your property's booking links, for example https://hotels.cloudbeds.com.
CLOUDBEDS_ALLOWED_ORIGIN=
