{
  "name": "circles-astro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "predev": "node scripts/check-node-version.mjs",
    "dev": "node scripts/print-mobile-url.mjs && ASTRO_TELEMETRY_DISABLED=1 wix dev",
    "predev:local": "node scripts/check-node-version.mjs",
    "dev:local": "ASTRO_TELEMETRY_DISABLED=1 astro dev --config astro.offline.config.mjs",
    "prebuild": "node scripts/check-node-version.mjs",
    "build": "ASTRO_TELEMETRY_DISABLED=1 wix build",
    "prepreview": "node scripts/check-node-version.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 wix preview",
    "precheck": "node scripts/check-node-version.mjs",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "assets:check": "node scripts/validate-figma-assets.mjs",
    "docs:check": "node scripts/validate-doc-links.mjs",
    "cms:audit": "CMS_AUDIT_HEALTH=1 node scripts/audit-wix-cms.mjs",
    "cms:audit:summary": "CMS_AUDIT_SUMMARY=1 node scripts/audit-wix-cms.mjs",
    "cms:audit:dump": "node scripts/audit-wix-cms.mjs",
    "cms:seed": "node scripts/seed-wix-cms.mjs",
    "cms:seed:staging": "node scripts/seed-wix-cms.mjs --apply",
    "cms:migrate:founders": "node scripts/cms/migrate-founders-program.mjs",
    "cms:migrate:june": "node scripts/cms/migrate-june-page.mjs",
    "cms:migrate:navigation": "node scripts/cms/restructure-happening-navigation.mjs",
    "cms:migrate:event-architecture": "node scripts/cms/migrate-event-architecture.mjs",
    "pretest": "node scripts/check-node-version.mjs",
    "test": "vitest run",
    "astro": "astro",
    "wix": "wix",
    "release": "ASTRO_TELEMETRY_DISABLED=1 wix release",
    "generate": "wix generate",
    "env": "wix env",
    "skills": "wix skills"
  },
  "dependencies": {
    "@astrojs/react": "7.1.1",
    "@tabler/icons-react": "3.49.0",
    "@tailwindcss/vite": "4.3.3",
    "@wix/data": "1.0.534",
    "@wix/site": "1.71.0",
    "astro": "7.4.2",
    "clsx": "2.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "@wix/sdk": "^1.15.23",
    "@wix/essentials": "^1.0.15",
    "@wix/dashboard": "^1.3.43"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "@wix/cli": "^1.1.92",
    "@wix/astro": "^3.0.1",
    "@wix/astro-pages": "^3.0.1",
    "@wix/astro-wix-hosting-adapter": "^3.0.2"
  }
}
