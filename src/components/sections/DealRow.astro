---
import type { Deal } from "@/domain/content";
import Button from "@/components/ui/Button.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Media from "@/components/ui/Media.astro";

type Props = { deal: Deal; first?: boolean };
const { deal, first = false } = Astro.props;
const paragraphs = deal.description.split(/\n{2,}/);
---

<!--
  Figma desktop: copy (vertically centered) | 540 × 572 image, rows separated by a rule.
  Figma mobile: eyebrow, title, description, rule, terms, button, then the image.
-->
<article
  id={deal.slug}
  class:list={[
    "grid border-b border-black/12 px-4 pb-4 lg:grid-cols-[minmax(0,636px)_540px] lg:justify-between lg:px-6 lg:pt-4",
    first ? "pt-17 lg:mt-8" : "pt-12",
  ]}
>
  <div class="flex flex-col justify-center">
    <Eyebrow class="text-black/50">{deal.eyebrow}</Eyebrow>
    <h2 class="mt-7 font-display text-h1 leading-[1.3] lg:mt-6 lg:leading-[1.08]">{deal.title}</h2>
    <div class="mt-2 font-display text-[1.125rem] leading-[1.2] lg:max-w-[600px]">
      {paragraphs.map((paragraph) => <p class="mb-5 last:mb-0">{paragraph}</p>)}
    </div>
    <div class="mt-18 border-t border-black/12 pt-4 lg:mt-19 lg:flex lg:items-center lg:justify-between lg:gap-8">
      <p class="text-[0.9375rem] leading-[1.35] lg:max-w-[400px] lg:text-[0.875rem]">{deal.terms}</p>
      {deal.cta && <Button href={deal.cta.href} class="mt-12 lg:mt-0">{deal.cta.label}</Button>}
    </div>
  </div>
  <div class="relative mt-10 aspect-[540/572] overflow-hidden lg:mt-0">
    <Media src={deal.image} alt="" />
  </div>
</article>
