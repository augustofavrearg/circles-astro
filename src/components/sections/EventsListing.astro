---
import type { EventSummary, EventsPage } from "@/domain/content";
import Button from "@/components/ui/Button.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import EventRow from "./EventRow.astro";

type Props = { page: EventsPage; events: EventSummary[]; city?: string };
const { page, events, city } = Astro.props;
const options = [{ slug: undefined, name: "All" }, ...page.cities];
const cityName = page.cities.find((item) => item.slug === city)?.name;
---

<!-- Figma "Events": heading, city filter (plain links, one URL per city), "View all", then the event rows. -->
<section class="px-4 pt-15 lg:px-6">
  <Eyebrow>{page.eyebrows[city ?? "all"] ?? page.eyebrows.all}</Eyebrow>
  <h1 class="mt-3 font-display text-h1 leading-[1.2] lg:leading-(--text-h1--line-height)">{page.title}</h1>
  <p class="mt-4 max-w-[640px] text-[0.9375rem] lg:mt-3 lg:text-[0.875rem]">{page.subtitle}</p>

  <div class="mt-6 lg:mt-14 lg:flex lg:items-center lg:justify-between">
    <nav aria-label="Filter events by city" class="inline-flex rounded-lg bg-black/8 p-0.5">
      {options.map((option) => {
        const active = option.slug === city;
        return (
          <a
            href={option.slug ? `/events/${option.slug}` : "/events"}
            aria-current={active ? "page" : undefined}
            class:list={[
              "flex h-6.5 min-w-22 items-center justify-center rounded-md px-4 text-detail transition-colors",
              active ? "bg-black text-white" : "text-black/45 hover:text-black",
            ]}
          >
            {option.name}
          </a>
        );
      })}
    </nav>
    {city && <Button href="/events" variant="secondary" class="mt-6 flex w-fit lg:mt-0">View all</Button>}
  </div>

  {events.length > 0 ? (
    <div class="mt-12 flex flex-col gap-2">
      {events.map((event) => <EventRow event={event} />)}
    </div>
  ) : (
    <p class="mt-12 bg-surface p-6 text-body">No events are scheduled{cityName ? ` in ${cityName}` : ""} yet.</p>
  )}
</section>
