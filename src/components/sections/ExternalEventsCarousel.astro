---
import type { EventCarousel } from "@/domain/content";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import { ScrollButtons } from "@/islands/ScrollButtons";

type Props = EventCarousel & { id: string };
const { id, eyebrow, title, items } = Astro.props;
---

<!-- Figma "External events" / "Seasonal events": heading with arrows, then centered grey cards. -->
<section class="pt-24">
  <header class="px-4 lg:px-6">
    <Eyebrow>{eyebrow}</Eyebrow>
    <h2 class="mt-3 font-display text-h2 leading-[1.25]">{title}</h2>
    {items.length > 1 && <ScrollButtons client:visible targetId={`${id}-track`} label={title} className="mt-3" />}
  </header>
  <div id={`${id}-track`} class="scrollbar-none mt-16 flex snap-x scroll-px-4 gap-2 overflow-x-auto px-4 lg:scroll-px-6 lg:px-6">
    {items.map((event) => (
      <article class="flex w-[438px] max-w-[calc(100vw-2rem)] shrink-0 snap-start flex-col items-center bg-surface px-1 pt-10 pb-5 text-center">
        <h3 class="px-4 font-display text-[2rem] leading-[1.25]">
          {event.href ? <a href={event.href} target="_blank" rel="noreferrer" class="hover:underline">{event.title}</a> : event.title}
        </h3>
        <div class="mt-7 size-[150px] bg-black/8">
          {event.image && <img src={event.image} alt="" loading="lazy" class="size-full object-cover" />}
        </div>
        <p class="mt-7 px-4 text-[0.9375rem] leading-[1.4]">{event.venue}</p>
        <div class="mt-3 w-full border-t border-black/12 pt-3">
          <p class="text-[0.9375rem]">{event.dateLabel}</p>
          <p class="text-detail text-black/50">{event.timeLabel}</p>
        </div>
      </article>
    ))}
  </div>
</section>
