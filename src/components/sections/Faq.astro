---
import { IconChevronDown } from "@tabler/icons-react";
import type { FaqItem } from "@/domain/content";
import SectionHeading from "@/components/ui/SectionHeading.astro";

type Props = { eyebrow: string; title: string; items: FaqItem[]; id?: string; centered?: boolean };
const { eyebrow, title, items, id = "faq", centered = false } = Astro.props;
---

<!-- Figma: "FAQ" — heading, then questions that expand in place; the first one starts open. Native <details>, no JS. -->
<section id={id} class="pt-28 lg:pt-34">
  <SectionHeading {eyebrow} {title} class={centered ? "lg:items-center lg:text-center" : undefined} />
  <div class="mt-20 px-4 lg:px-6">
    <div class:list={["lg:max-w-[1120px]", centered && "lg:mx-auto"]}>
      {items.map((item, index) => (
        <details class="group border-b border-black/12" open={index === 0}>
          <summary class="flex cursor-pointer list-none items-center gap-4 py-6 [&::-webkit-details-marker]:hidden">
            <span class="min-w-0 flex-1 font-display text-[1.25rem] leading-[1.3] lg:text-[2rem] lg:leading-[1.2] lg:uppercase">{item.question}</span>
            <span aria-hidden="true" class="flex size-8 shrink-0 items-center justify-center rounded-full bg-black/8 transition-transform duration-200 group-open:rotate-180">
              <IconChevronDown size={16} stroke={1.5} />
            </span>
          </summary>
          <div class="pb-6 text-[0.9375rem] leading-[1.4]">
            {item.answer.map((block) =>
              block.type === "paragraph" ? (
                <p class="mb-5 whitespace-pre-line last:mb-0">{block.text}</p>
              ) : (
                <ul class="mb-5 list-[square] pl-6 marker:text-[0.5em] last:mb-0">
                  {block.items.map((entry) => <li>{entry}</li>)}
                </ul>
              ),
            )}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
