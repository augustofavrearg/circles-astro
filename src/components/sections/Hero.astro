---
import { IconChevronDown } from "@tabler/icons-react";
import type { HomePage } from "@/domain/content";
import { BookingSearch } from "@/islands/BookingSearch";
import { VideoTeaser } from "@/islands/VideoTeaser";

type Props = HomePage["hero"] & { searchLocations: HomePage["searchLocations"]; nextSectionId?: string };
const { title, description, video, searchLocations, nextSectionId } = Astro.props;
---

<section class="relative overflow-hidden px-4 pt-9 pb-12 lg:px-6 lg:pt-16 lg:pb-17">
  <div class="mx-auto grid w-full min-w-0 max-w-[1500px] gap-10 lg:grid-cols-[minmax(0,1fr)_317px] lg:gap-16">
    <div class="flex min-w-0 flex-col">
      <h1 class="reveal-copy max-w-[880px] font-display text-h1 text-balance">{title}</h1>
      <p class="reveal-copy mt-6 max-w-[500px] text-body" style="animation-delay:100ms">{description}</p>
      <div class="reveal-copy mt-12 min-w-0" style="animation-delay:180ms">
        <BookingSearch client:load locations={searchLocations} />
      </div>
    </div>
    {video && (
      <div class="reveal-image min-w-0 self-start">
        <VideoTeaser client:idle {...video} />
      </div>
    )}
  </div>
  {nextSectionId && (
    <a
      href={`#${nextSectionId}`}
      aria-label="Scroll to the next section"
      class="absolute right-4 bottom-12 hidden size-6 items-center justify-center lg:right-6 lg:bottom-17 lg:flex"
    >
      <IconChevronDown size={18} stroke={1.5} />
    </a>
  )}
</section>
