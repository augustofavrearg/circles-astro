---
import type { ForInvestorsPage } from "@/domain/content";
import Eyebrow from "@/components/ui/Eyebrow.astro";

type Props = ForInvestorsPage["benefits"];
const { eyebrow, title, items } = Astro.props;
---

<!-- Figma "Advantages of Being an Investor": centered heading, then grey centered cards (three columns on desktop). -->
<section class="pt-30 lg:pt-28">
  <header class="px-4 text-center lg:px-6">
    <Eyebrow>{eyebrow}</Eyebrow>
    <h2 class="mt-3 font-display text-h2 leading-[1.25] lg:leading-(--text-h2--line-height)">{title}</h2>
  </header>
  <ul class="mt-20 grid gap-2 px-4 lg:mt-17 lg:grid-cols-3 lg:px-6">
    {items.map((item) => (
      <li class="flex flex-col items-center bg-surface px-6 pt-7 pb-7 text-center lg:pt-8">
        <p class="text-[0.9375rem] lg:text-detail">{item.label}</p>
        <h3 class="mt-5 font-display text-[2.375rem] leading-[1.2] lg:mt-4 lg:max-w-[330px] lg:text-[2rem] lg:leading-[1.3]">{item.title}</h3>
        <div class="mt-6 size-[212px] bg-black/8 lg:mt-4 lg:size-[117px]">
          {item.image && <img src={item.image} alt="" loading="lazy" class="size-full object-cover" />}
        </div>
        <p class="mt-7 max-w-[540px] text-[1.0625rem] leading-[1.4] lg:mt-5 lg:text-[0.875rem]">{item.text}</p>
      </li>
    ))}
  </ul>
</section>
