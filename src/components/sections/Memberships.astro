---
import type { HomePage } from "@/domain/content";
import Button from "@/components/ui/Button.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Media from "@/components/ui/Media.astro";

type Props = HomePage["memberships"];
const { eyebrow, title, description, cta, image, thumbnail } = Astro.props;
---

<section id="membership" class="relative isolate flex min-h-[820px] p-4 lg:min-h-[768px] lg:p-6">
  <Media src={image} alt="Circles House members" class="-z-10" />
  <div class="flex w-full flex-col items-center bg-background px-7 pt-7 pb-6 text-center lg:min-h-[716px] lg:w-[540px]">
    <Eyebrow>{eyebrow}</Eyebrow>
    <h2 class="mt-12 font-display text-[2.5rem] leading-[1.15]">{title}</h2>
    <div class="relative my-auto size-[134px] shrink-0 overflow-hidden">
      <Media src={thumbnail} alt="Members gathering at Circles House" />
    </div>
    <p class="max-w-[480px] text-[0.9375rem] leading-[1.35]">{description}</p>
    <Button href={cta.href} class="mt-12">{cta.label}</Button>
  </div>
</section>
