---
import type { HomePage } from "@/domain/content";
import Button from "@/components/ui/Button.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Media from "@/components/ui/Media.astro";

type Props = HomePage["memberships"];
const { eyebrow, title, description, cta, highlights, image, thumbnail } = Astro.props;
---

<section id="membership" class="relative isolate flex min-h-[820px] flex-col gap-4 p-4 lg:min-h-[768px] lg:flex-row lg:items-end lg:p-6">
  <Media src={image} alt="Circles House members" overlay class="-z-10" />
  <div class="flex w-full flex-col items-center gap-10 bg-background p-7 text-center lg:min-h-[716px] lg:w-[540px]">
    <Eyebrow>{eyebrow}</Eyebrow>
    <h2 class="font-display text-h2">{title}</h2>
    <div class="relative size-[150px] shrink-0 overflow-hidden rounded-full">
      <Media src={thumbnail} alt="Members gathering at Circles House" />
    </div>
    <p class="mt-auto max-w-sm text-body">{description}</p>
    <Button href={cta.href}>{cta.label}</Button>
  </div>
  <ul class="mt-auto flex flex-1 gap-4 pb-3 text-white lg:justify-end">
    {highlights.map((highlight, index) => (
      <li class:list={["flex-1 border-t pt-3 text-cta", index === 0 ? "border-white" : "border-white/30"]}>{highlight}</li>
    ))}
  </ul>
</section>
