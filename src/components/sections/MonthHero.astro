---
import type { MonthPage } from "@/domain/content";
import Button from "@/components/ui/Button.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Media from "@/components/ui/Media.astro";

type Props = MonthPage["hero"];
const { eyebrow, title, body, cta, image } = Astro.props;
---

<!-- Figma month hero: full-bleed photo under a dark overlay, white copy and a yellow title. -->
<section class="relative isolate overflow-hidden bg-[#3b4045] px-4 pt-21 pb-10 text-white lg:px-6 lg:pt-28 lg:pb-16">
  <!-- Neutral dark fallback while the photo is pending, so the black button stays visible. -->
  <Media src={image} alt="" eager overlay class="-z-10 bg-transparent" imageClass="opacity-70" />
  <Eyebrow>{eyebrow}</Eyebrow>
  <h1 class="mt-3 max-w-[760px] font-display text-[2.375rem] leading-[1.25] text-yellow lg:text-h1 lg:leading-(--text-h1--line-height)">{title}</h1>
  <p class="mt-5 max-w-[620px] text-[1.0625rem] leading-[1.4] whitespace-pre-line">{body}</p>
  {cta && <Button href={cta.href} class="mt-12">{cta.label}</Button>}
</section>
