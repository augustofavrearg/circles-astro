---
import type { HomePage } from "@/domain/content";
import Media from "@/components/ui/Media.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";

type Props = HomePage["news"];
const { eyebrow, title, items } = Astro.props;
---

<section id="news" class="py-28">
  <SectionHeading {eyebrow} {title} />
  <div class="scrollbar-none mt-12 flex snap-x gap-4 overflow-x-auto px-4 lg:px-6">
    {items.map((item) => (
      <a href={item.href} class="group w-[86vw] max-w-[540px] shrink-0 snap-start">
        <div class="relative h-[420px] overflow-hidden">
          <Media src={item.image} alt={item.title} imageClass="transition-transform duration-700 group-hover:scale-105" />
          <span class="absolute top-4 left-4 rounded-full bg-white px-3 py-2 text-detail">{item.category}</span>
        </div>
        <p class="mt-4 text-detail text-black/50">{item.date}</p>
        <h3 class="mt-3 font-display text-[2rem] leading-none">{item.title}</h3>
        <p class="mt-3 line-clamp-2 text-body">{item.excerpt}</p>
      </a>
    ))}
  </div>
</section>
