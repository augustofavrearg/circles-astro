---
const { description } = Astro.props as { description: string };
---

<section class="px-4 lg:px-6">
  <div class="grid gap-12 bg-black p-7 text-white lg:grid-cols-[1fr_0.7fr] lg:items-end lg:p-12">
    <h2 class="font-display text-h1">Join our Newsletter</h2>
    <div>
      <p class="font-display text-h3">{description}</p>
      <form class="mt-8 flex items-center gap-3 border-b border-white/70 py-3" aria-describedby="newsletter-note">
        <label for="newsletter-email" class="sr-only">Email</label>
        <input id="newsletter-email" type="email" name="email" autocomplete="email" placeholder="Newsletter integration pending" disabled class="min-w-0 flex-1 bg-transparent text-white placeholder:text-white/60" />
        <button type="submit" disabled class="size-9 rounded-full border border-white/50" aria-label="Newsletter provider not configured">→</button>
      </form>
      <p id="newsletter-note" class="mt-3 text-detail text-white/60">Subscriptions will open once the email provider and consent text are approved.</p>
    </div>
  </div>
</section>
