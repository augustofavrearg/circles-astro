---
import type { PageIntro } from "@/domain/content";
import Button from "@/components/ui/Button.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Media from "@/components/ui/Media.astro";
import { cn } from "@/lib/cn";

type Props = { intro: PageIntro; imageAlt: string; bodyClass?: string };
const { intro, imageAlt, bodyClass } = Astro.props;
---

<!--
  Figma (Ambassadors, Partnerships, For Investors).
  Mobile: eyebrow, title, red lead, body, button, full-width image, note.
  Desktop: copy | full-height image | note; the body drops to the bottom of the first column.
-->
<section class="grid px-4 pt-13 lg:h-[511px] lg:grid-cols-[minmax(0,1fr)_325px_196px] lg:gap-x-6 lg:border-b lg:border-black/12 lg:px-6 lg:pt-0">
  <div class="flex flex-col lg:pt-15 lg:pb-1">
    <Eyebrow>{intro.eyebrow}</Eyebrow>
    <h1 class="mt-3 max-w-[760px] font-display text-h1 leading-[1.2] lg:leading-(--text-h1--line-height)">{intro.title}</h1>
    <p class="mt-4 max-w-[700px] font-display text-[1.1875rem] leading-[1.15] text-red lg:text-[2.125rem] lg:leading-[1.25]">{intro.lead}</p>
    <p class={cn("mt-4 whitespace-pre-line text-[0.9375rem] leading-[1.4] lg:order-last lg:mt-auto lg:max-w-[720px]", bodyClass)}>{intro.body}</p>
    {(intro.cta || intro.secondaryCta) && (
      <div class="mt-12 flex gap-3 lg:mt-10">
        {intro.secondaryCta && <Button href={intro.secondaryCta.href} variant="secondary">{intro.secondaryCta.label}</Button>}
        {intro.cta && <Button href={intro.cta.href} class={intro.secondaryCta ? undefined : "min-w-58"}>{intro.cta.label}</Button>}
      </div>
    )}
  </div>
  <div class="relative mt-4 h-[720px] overflow-hidden lg:mt-0 lg:h-full">
    <Media src={intro.image} alt={imageAlt} eager />
  </div>
  {intro.note && <p class="mt-4 max-w-[200px] text-[0.9375rem] leading-[1.4] lg:mt-0 lg:-ml-2 lg:max-w-none lg:self-end lg:pb-1">{intro.note}</p>}
</section>
