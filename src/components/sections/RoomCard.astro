---
import type { Room } from "@/domain/booking";
import Button from "@/components/ui/Button.astro";
import { ManifestoGallery } from "@/islands/ManifestoGallery";

type Props = { room: Room; bookingHref: string };
const { room, bookingHref } = Astro.props;
const photos = room.gallery?.length ? room.gallery : room.image ? [room.image] : [];
---

<!-- Figma "A Room for your Needs" card: photo gallery with the house tag, features, name, views, price and actions. -->
<article class="border border-black/8 bg-white">
  <div class="relative aspect-[455/432]">
    {photos.length > 1 ? (
      <ManifestoGallery client:visible images={photos} label={`${room.name} photos`} />
    ) : (
      <ManifestoGallery images={photos} label={`${room.name} photos`} />
    )}
    {room.houseLabel && <span class="absolute top-4 left-4 rounded bg-black/45 px-4 py-1 text-detail text-white">{room.houseLabel}</span>}
  </div>
  <div class="p-4 pt-5">
    {room.features && room.features.length > 0 && (
      <ul class="flex flex-wrap gap-x-2 gap-y-0.5 text-detail text-black/50">
        {room.features.map((feature, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true" class="size-1 rounded-full bg-red" />}
            {feature}
          </li>
        ))}
      </ul>
    )}
    <h3 class="mt-5 font-display text-[2.25rem] leading-[1.2]">{room.name}</h3>
    {room.views && <p class="mt-1 font-display text-[1.125rem] text-red">{room.views}</p>}
    {room.description && <p class="mt-5 text-[0.9375rem] leading-[1.4]">{room.description}</p>}
    <div class="mt-6 border-t border-black/12 pt-5">
      {room.price && (
        <p class="text-[1.125rem]">
          <span class="block text-[0.9375rem] text-black/50">{room.price.label}</span>
          {room.price.value}
        </p>
      )}
      <div class="mt-3 flex gap-1">
        <!-- Availability, dates and payment stay in Cloudbeds. "Contact" appears once it has a destination. -->
        <Button href={bookingHref} rel="external">Choose dates</Button>
      </div>
    </div>
  </div>
</article>
