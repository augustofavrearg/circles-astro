---
import type { CoworkingPage } from "@/domain/content";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Media from "@/components/ui/Media.astro";

type Props = CoworkingPage["hero"];
const { eyebrow, title, subtitle, image } = Astro.props;
---

<section aria-labelledby="coworking-title">
  <header class="px-4 pt-8 pb-12 lg:px-6 lg:pt-12 lg:pb-16">
    <Eyebrow>{eyebrow}</Eyebrow>
    <h1 id="coworking-title" class="mt-3 max-w-[1050px] text-balance font-display text-h1 leading-[1.12] lg:leading-(--text-h1--line-height)">
      {title}
    </h1>
    <p class="mt-4 max-w-[680px] text-[0.9375rem] leading-[1.4] lg:text-[0.8125rem]">{subtitle}</p>
  </header>

  <div class="relative h-[520px] overflow-hidden lg:h-[765px]">
    <Media src={image} alt="Coworking at Circles House Barcelona" eager placeholderTone="yellow" />
  </div>
</section>
