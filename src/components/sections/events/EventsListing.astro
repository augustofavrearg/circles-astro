---
import type { EventListingHeading, EventSummary } from "@/domain/content";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import EventRow from "@/components/sections/shared/EventRow.astro";

type Props = { heading: EventListingHeading; events: EventSummary[]; emptyDetail?: string };
const { heading, events, emptyDetail } = Astro.props;
---

<!-- Figma "Events": heading and event rows. View and location switching live in HappeningNavigation. -->
<section class="px-4 pt-15 lg:px-6">
  {heading.eyebrow && <Eyebrow>{heading.eyebrow}</Eyebrow>}
  <h2 class:list={["max-w-full text-balance break-words font-display text-h1 leading-[1.2] lg:leading-(--text-h1--line-height)", heading.eyebrow && "mt-3"]}>{heading.title}</h2>
  {heading.subtitle && <p class="mt-4 max-w-[640px] text-[0.9375rem] lg:mt-3 lg:text-[0.875rem]">{heading.subtitle}</p>}

  {events.length > 0 ? (
    <div class="mt-12 flex flex-col gap-2 lg:mt-14">
      {events.map((event) => <EventRow event={event} />)}
    </div>
  ) : (
    <p class="mt-12 bg-surface p-6 text-body">No events match{emptyDetail ? ` ${emptyDetail}` : " the selected filters"}.</p>
  )}
</section>
