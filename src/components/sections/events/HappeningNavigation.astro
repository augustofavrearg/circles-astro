---
import type { HeaderNavigation, NavigationItem } from "@/domain/navigation";
import { isNavigationLink, isPathCurrent } from "@/domain/navigation";
import { routes, siteNavigation } from "@/config/navigation";

type Kind = "events" | "months" | "programs";
type Props = {
  navigation?: HeaderNavigation;
  cities: { slug: string; name: string }[];
  currentPath: string;
  kind: Kind;
};

const { navigation = siteNavigation.header, cities, currentPath, kind } = Astro.props;

function flatten(items: readonly NavigationItem[]): NavigationItem[] {
  return items.flatMap((item) => item.status === "link" && item.children
    ? [item, ...flatten(item.children)]
    : [item]);
}

function linksFor(prefix: string) {
  const seen = new Set<string>();
  return flatten(navigation.primary)
    .filter(isNavigationLink)
    .filter((item) => item.href.startsWith(prefix))
    .filter((item) => {
      if (seen.has(item.href)) return false;
      seen.add(item.href);
      return true;
    });
}

const monthLinks = linksFor("/months/");
const programLinks = linksFor("/programs/");
const groups = [
  { kind: "events" as const, label: "Events", href: routes.events },
  ...(monthLinks[0] ? [{ kind: "months" as const, label: "Months", href: monthLinks[0].href }] : []),
  ...(programLinks[0] ? [{ kind: "programs" as const, label: "Programs", href: programLinks[0].href }] : []),
];
const options = kind === "events"
  ? [
      { label: "All", href: routes.events },
      ...cities.map((city) => ({ label: city.name, href: routes.cityEvents(city.slug) })),
    ]
  : (kind === "months" ? monthLinks : programLinks).map(({ label, href }) => ({ label, href }));
---

<section aria-label="Explore events, months and programs" class="border-b border-black/12 px-4 py-5 lg:px-6 lg:py-6">
  <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
    <nav aria-label="Happening now views" class="flex flex-wrap items-center gap-x-6 gap-y-2">
      {groups.map((group) => (
        <a
          href={group.href}
          aria-current={group.kind === kind ? "page" : undefined}
          class:list={[
            "font-display text-[1.375rem] leading-none transition-opacity hover:opacity-50 lg:text-[1.625rem]",
            group.kind === kind ? "underline decoration-1 underline-offset-6" : "text-black/45",
          ]}
        >
          {group.label}
        </a>
      ))}
    </nav>

    {options.length > 0 && (
      <nav aria-label={`Filter ${kind}`} class="inline-flex w-fit max-w-full flex-wrap rounded-lg bg-black/8 p-0.5">
        {options.map((option) => {
          const active = isPathCurrent(currentPath, option.href);
          return (
            <a
              href={option.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "flex h-7 min-w-22 items-center justify-center rounded-md px-4 text-detail transition-colors",
                active ? "bg-black text-white" : "text-black/45 hover:text-black",
              ]}
            >
              {option.label}
            </a>
          );
        })}
      </nav>
    )}
  </div>
</section>
