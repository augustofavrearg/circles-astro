---
import type { ForInvestorsPage } from "@/domain/content";
import Button from "@/components/ui/Button.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Media from "@/components/ui/Media.astro";

type Props = NonNullable<ForInvestorsPage["features"]>;
const { eyebrow, title, items } = Astro.props;
---

<!--
  Figma "Investment Features": heading, then rows of copy (title, text, button) | image, separated by rules.
  Mobile: title, text, button, then the image.
-->
<section class="pt-40 lg:pt-37">
  <header class="px-4 lg:px-6">
    <Eyebrow>{eyebrow}</Eyebrow>
    <h2 class="mt-3 font-display text-h2">{title}</h2>
  </header>
  <div class="mt-8 px-4 lg:mt-14 lg:px-6">
    {items.map((item) => (
      <article class="grid border-b border-black/12 py-12 first:pt-16 lg:grid-cols-[minmax(0,620px)_540px] lg:items-center lg:justify-between lg:gap-x-12 lg:py-3.5 lg:first:pt-0">
        <div>
          <h3 class="font-display text-h2 leading-[1.2] lg:leading-[1.15]">{item.title}</h3>
          <p class="mt-16 text-[1.0625rem] leading-[1.45] lg:mt-12 lg:text-[0.875rem]">{item.text}</p>
          {item.cta && <Button href={item.cta.href} class="mt-14 lg:mt-10">{item.cta.label}</Button>}
        </div>
        <div class="relative mt-8 aspect-[540/566] overflow-hidden lg:mt-0">
          <Media src={item.image} alt="" />
        </div>
      </article>
    ))}
  </div>
</section>
