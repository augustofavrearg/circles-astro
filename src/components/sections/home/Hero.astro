---
import { IconChevronDown } from "@tabler/icons-react";
import type { HomePage } from "@/domain/content";
import { BookingSearch } from "@/islands/BookingSearch";
import { VideoTeaser } from "@/islands/VideoTeaser";

type Props = HomePage["hero"] & { searchLocations: HomePage["searchLocations"]; nextSectionId?: string };
const { title, description, video, searchLocations, nextSectionId } = Astro.props;
---

<!-- Mobile order (Figma): title, video, description, search. Desktop: video in its own column. -->
<section class="relative overflow-hidden px-4 pt-6 pb-4 lg:px-6 lg:pt-16 lg:pb-17">
  <div class="mx-auto grid w-full min-w-0 max-w-[1500px] lg:grid-cols-[minmax(0,1fr)_317px] lg:grid-rows-[auto_auto_1fr] lg:gap-x-16">
    <h1 class="reveal-copy min-w-0 max-w-[880px] font-display text-h1 leading-[1.24] lg:col-start-1 lg:row-start-1 lg:leading-(--text-h1--line-height)">{title}</h1>
    {video && (
      <div class="reveal-image mt-10 w-[317px] max-w-full min-w-0 justify-self-end lg:col-start-2 lg:row-span-3 lg:row-start-1 lg:mt-0 lg:w-auto lg:justify-self-stretch">
        <VideoTeaser client:idle {...video} />
      </div>
    )}
    <p class="reveal-copy mt-10 max-w-[500px] text-body lg:col-start-1 lg:row-start-2 lg:mt-6" style="animation-delay:100ms">{description}</p>
    <div class="reveal-copy mt-10 min-w-0 lg:col-start-1 lg:row-start-3 lg:mt-12" style="animation-delay:180ms">
      <BookingSearch client:load locations={searchLocations} />
    </div>
  </div>
  {nextSectionId && (
    <a
      href={`#${nextSectionId}`}
      aria-label="Scroll to the next section"
      class="absolute right-4 bottom-12 hidden size-6 items-center justify-center lg:right-6 lg:bottom-17 lg:flex"
    >
      <IconChevronDown size={18} stroke={1.5} />
    </a>
  )}
</section>
