---
import type { HomePage } from "@/domain/content";
import Button from "@/components/ui/Button.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Media from "@/components/ui/Media.astro";

type Props = HomePage["memberships"];
const { eyebrow, title, description, cta, highlights, image, thumbnail } = Astro.props;
---

<section id="membership" class="relative isolate flex min-h-[960px] flex-col gap-4 p-4 lg:min-h-[768px] lg:flex-row lg:items-end lg:p-6">
  <Media src={image} alt="Circles House members" class="-z-10" placeholderTone="blue" />
  <div aria-hidden="true" class="absolute inset-x-0 bottom-0 -z-10 h-40 bg-linear-to-b from-black/0 to-black/35"></div>
  <div class="flex w-full flex-col items-center bg-background px-7 pt-7 pb-6 text-center lg:min-h-[716px] lg:w-[540px] lg:self-stretch">
    <Eyebrow>{eyebrow}</Eyebrow>
    <h2 class="mt-12 font-display text-[2.5rem] leading-[1.15]">{title}</h2>
    <div class="relative my-12 size-[134px] shrink-0 overflow-hidden lg:my-auto">
      <Media src={thumbnail} alt="Members gathering at Circles House" placeholderTone="yellow" />
    </div>
    <p class="max-w-[480px] text-[0.9375rem] leading-[1.35]">{description}</p>
    <Button href={cta.href} class="mt-12">{cta.label}</Button>
  </div>
  {highlights.length > 0 && (
    <ul class="mt-auto flex gap-4 text-white lg:flex-1 lg:pb-3">
      {highlights.map((highlight, index) => (
        <li class:list={["flex-1 border-t pt-2 text-[0.9375rem]", index === 0 ? "border-white" : "border-transparent"]}>{highlight}</li>
      ))}
    </ul>
  )}
</section>
