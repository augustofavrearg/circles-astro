---
import type { LocationPage } from "@/domain/content";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Media from "@/components/ui/Media.astro";
import { ScrollButtons } from "@/islands/ScrollButtons";

type Props = LocationPage["experiences"] & { id: string };
const { id, eyebrow, title, subtitle, items } = Astro.props;
---

<!-- Figma "Travel slowly": centered heading and arrows, then photos (narrow and wide) with a dark caption. -->
<section {id} class="scroll-mt-32 pt-28 lg:pt-32">
  <header class="flex flex-col items-center px-4 text-center lg:px-6">
    <Eyebrow>{eyebrow}</Eyebrow>
    <h2 class="mt-3 font-display text-[3.75rem] leading-[1.1] lg:text-h1 lg:leading-(--text-h1--line-height)">{title}</h2>
    <p class="mt-4 text-[0.9375rem] lg:text-[0.8125rem]">{subtitle}</p>
    {items.length > 1 && <ScrollButtons client:visible targetId={`${id}-track`} label="experience" className="mt-10" />}
  </header>
  <div id={`${id}-track`} class="scrollbar-none mt-12 flex snap-x scroll-px-4 gap-1 overflow-x-auto px-4 lg:mt-12 lg:scroll-px-4 lg:px-4">
    {items.map((item) => (
      <figure class:list={["relative h-[670px] w-[calc(100vw-2rem)] shrink-0 snap-start overflow-hidden lg:h-[675px]", item.wide ? "lg:w-[890px]" : "lg:w-[450px]"]}>
        <Media src={item.image} alt="" />
        <figcaption class="absolute bottom-4 left-4 max-w-[calc(100%-2rem)] bg-black/55 px-3 py-2 text-white lg:max-w-[300px]">
          <p class="font-display text-[1.125rem] leading-[1.2]">{item.title}</p>
          <p class="mt-0.5 text-detail leading-[1.25]">{item.text}</p>
        </figcaption>
      </figure>
    ))}
  </div>
</section>
