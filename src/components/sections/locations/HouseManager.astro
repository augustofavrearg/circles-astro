---
import type { LocationPage } from "@/domain/content";

type Props = LocationPage["manager"];
const { eyebrow, title, paragraphs, image } = Astro.props;
---

<!-- Figma "Meet your House Manager": red band, title and two text columns beside the photo. -->
<section class="bg-red px-4 pt-6 pb-4 lg:mt-32 lg:grid lg:min-h-[650px] lg:grid-cols-[minmax(0,1fr)_545px] lg:gap-12 lg:px-6 lg:py-11">
  <div class="flex flex-col">
    <p class="mt-8 font-display text-[0.9375rem] lg:mt-14 lg:text-[0.8125rem]">{eyebrow}</p>
    <h2 class="mt-1 max-w-[340px] font-display text-[2rem] leading-[1.2] lg:mt-3 lg:max-w-[460px] lg:text-h1 lg:leading-[1.15]">{title}</h2>
    <div class="mt-12 grid grid-cols-2 gap-4 text-[0.8125rem] leading-[1.4] lg:mt-auto lg:mb-14 lg:max-w-[700px] lg:gap-6 lg:text-[0.8125rem]">
      {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
  <div class="mt-12 aspect-[290/375] bg-black/8 lg:mt-0 lg:aspect-[545/565]">
    {image && <img src={image} alt="" loading="lazy" class="size-full object-cover" />}
  </div>
</section>
