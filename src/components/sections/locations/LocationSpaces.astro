---
import type { LocationSpaceSummary } from "@/domain/content";
import Media from "@/components/ui/Media.astro";

type Props = { spaces: LocationSpaceSummary[]; locationName: string };
const { spaces, locationName } = Astro.props;
---

<section id="spaces" class="scroll-mt-32 bg-black px-4 py-20 text-white lg:px-6 lg:py-28">
  <header class="grid gap-5 border-b border-white/25 pb-10 lg:grid-cols-[1fr_420px] lg:items-end">
    <div>
      <p class="text-detail uppercase text-white/65">Explore the house</p>
      <h2 class="mt-3 max-w-[760px] font-display text-[2.75rem] leading-[1.02] lg:text-[4.5rem]">
        More than a place to stay
      </h2>
    </div>
    <p class="max-w-[430px] text-[0.9375rem] leading-[1.45] text-white/75 lg:justify-self-end">
      Discover the spaces, services and experiences available at Circles House {locationName}.
    </p>
  </header>

  <div class="grid gap-px bg-white/20 lg:grid-cols-2">
    {spaces.map((space, index) => (
      <a href={space.href} class="group grid min-h-[520px] bg-black pt-12 focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-white lg:min-h-[650px]">
        <div class="flex items-start justify-between gap-6 px-5 lg:px-8">
          <div>
            <p class="text-detail uppercase text-white/60">{space.category}</p>
            <h3 class="mt-3 max-w-[520px] font-display text-[2.5rem] leading-[1.02] lg:text-[3.75rem]">{space.title}</h3>
          </div>
          <span aria-hidden="true" class="mt-1 text-[2rem] transition-transform duration-300 group-hover:translate-x-2">→</span>
        </div>
        <p class="mt-5 max-w-[560px] px-5 text-[0.9375rem] leading-[1.45] text-white/70 lg:px-8">{space.description}</p>
        <div class="relative mt-10 min-h-[270px] overflow-hidden self-end lg:min-h-[365px]">
          <Media src={space.image} alt="" placeholderTone={index % 2 === 0 ? "blue" : "yellow"} imageClass="transition-transform duration-500 group-hover:scale-[1.02]" />
          {space.status === "comingSoon" && <span class="absolute right-4 top-4 rounded-full bg-red px-4 py-2 text-detail text-black">Coming soon</span>}
        </div>
      </a>
    ))}
  </div>
</section>
