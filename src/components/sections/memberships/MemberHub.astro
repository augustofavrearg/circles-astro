---
import { IconClockHour4, IconUserCircle, IconWorld } from "@tabler/icons-react";
import type { MembershipsPage } from "@/domain/content";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Button from "@/components/ui/Button.astro";
import { mediaPlaceholderClass, USE_MEDIA_PLACEHOLDERS } from "@/config/media";

type Props = MembershipsPage["hub"];
const { eyebrow, title, subtitle, topics, text, images, stats, cta } = Astro.props;
const icons = { globe: IconWorld, age: IconUserCircle, stay: IconClockHour4 };
const [large, wide, small] = images;

const slot = "object-cover";
---

<!--
  Figma "Circles Member Hub" (grey band). Mobile: everything stacked. Desktop: a free composition —
  text top left, wide photo top right, topics in the middle, large photo bottom left, small photo and stats on the right.
-->
<section class="mt-20 bg-[#ebe9e3] px-4 pt-10 pb-6 lg:mt-28 lg:px-6 lg:pt-30 lg:pb-30">
  <header class="text-center">
    <Eyebrow>{eyebrow}</Eyebrow>
    <h2 class="mt-3 font-display text-[2rem] leading-[1.2] lg:text-h1 lg:leading-(--text-h1--line-height)">{title}</h2>
    <p class="mx-auto mt-2 max-w-[360px] text-[0.9375rem] leading-[1.4] lg:max-w-none lg:text-[0.875rem]">{subtitle}</p>
    {cta && <Button href={cta.href} target="_blank" rel="noreferrer" class="mt-6">{cta.label}</Button>}
  </header>

  <div class="mt-12 grid lg:mt-32 lg:grid-cols-[318px_minmax(0,1fr)_318px] lg:grid-rows-[auto_auto_auto] lg:gap-x-6">
    <ul class="order-1 text-center font-display text-[2.25rem] leading-[1.2] lg:order-none lg:col-start-2 lg:row-span-2 lg:row-start-2 lg:self-center lg:text-[1.875rem]">
      {topics.map((topic, index) => (
        <li class:list={["mx-auto max-w-[320px] lg:max-w-[340px]", index === 0 ? "text-red underline decoration-1 underline-offset-[6px]" : "mt-3 text-black/55"]}>{topic}</li>
      ))}
    </ul>
    <p class="order-2 mt-6 text-[0.9375rem] leading-[1.4] lg:order-none lg:col-start-1 lg:row-start-1 lg:mt-0 lg:text-[0.875rem]">{text}</p>
    <div class="order-3 mt-6 aspect-[318/328] w-[318px] max-w-[85%] lg:order-none lg:col-start-1 lg:row-span-2 lg:row-start-2 lg:mt-16 lg:max-w-none lg:self-end">
      {!USE_MEDIA_PLACEHOLDERS && large ? <img src={large} alt="" loading="lazy" class={`size-full ${slot}`} /> : <div aria-hidden="true" class={`size-full ${mediaPlaceholderClass("yellow")}`} />}
    </div>
    <div class="order-4 mt-4 ml-auto aspect-[318/154] w-[318px] max-w-[85%] lg:order-none lg:col-start-3 lg:row-start-1 lg:mt-0 lg:max-w-none">
      {!USE_MEDIA_PLACEHOLDERS && wide ? <img src={wide} alt="" loading="lazy" class={`size-full ${slot}`} /> : <div aria-hidden="true" class={`size-full ${mediaPlaceholderClass("blue")}`} />}
    </div>
    <div class="order-5 mt-8 lg:order-none lg:col-start-3 lg:row-start-3 lg:mt-0 lg:self-end">
      <ul class="flex flex-wrap gap-x-4 gap-y-3 text-[0.8125rem]">
        {stats.map((stat) => {
          const Icon = icons[stat.icon];
          return (
            <li class="flex items-center gap-1.5">
              <Icon size={16} stroke={1.5} aria-hidden="true" />
              {stat.label}
            </li>
          );
        })}
      </ul>
    </div>
    <div class="order-6 mx-auto mt-8 aspect-[115/154] w-[115px] lg:order-none lg:col-start-3 lg:row-start-2 lg:mx-0 lg:mt-24 lg:-ml-[62px]">
      {!USE_MEDIA_PLACEHOLDERS && small ? <img src={small} alt="" loading="lazy" class={`size-full ${slot}`} /> : <div aria-hidden="true" class={`size-full ${mediaPlaceholderClass("yellow")}`} />}
    </div>
  </div>
</section>
