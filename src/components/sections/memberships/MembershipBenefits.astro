---
import type { MembershipsPage } from "@/domain/content";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Media from "@/components/ui/Media.astro";

type Props = MembershipsPage["benefits"];
const { eyebrow, title, image, items } = Astro.props;
---

<!--
  Figma "Membership Benefits": rows of title | text, the first one above a red rule.
  Desktop adds a small photo on the right that overlaps the first rows.
-->
<section class="px-4 pt-34 lg:px-6 lg:pt-28">
  <Eyebrow>{eyebrow}</Eyebrow>
  <h2 class="mt-3 font-display text-h2">{title}</h2>
  <ul class="relative mt-20 lg:mt-8">
    <div class="absolute top-0 right-[42px] z-10 hidden h-[174px] w-[117px] overflow-hidden lg:block">
      <Media src={image} alt="" placeholderTone="blue" />
    </div>
    {items.map((item, index) => (
      <li class:list={["grid gap-4 py-6 lg:grid-cols-[444px_minmax(0,640px)] lg:items-center lg:gap-0", index === 0 ? "border-b border-red" : "border-b border-black/12"]}>
        <h3 class="font-display text-[1.125rem] leading-[1.3]">{item.title}</h3>
        <p class="text-[0.9375rem] leading-[1.4] lg:text-[0.875rem]">{item.text}</p>
      </li>
    ))}
  </ul>
</section>
