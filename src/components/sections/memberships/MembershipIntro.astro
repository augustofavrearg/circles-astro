---
import type { MembershipsPage } from "@/domain/content";
import Button from "@/components/ui/Button.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Media from "@/components/ui/Media.astro";

type Props = MembershipsPage["intro"];
const { eyebrow, title, body, cta, image } = Astro.props;
---

<!-- Figma "Become a Member": copy and actions, then a full-bleed photo. -->
<section>
  <div class="px-4 pt-13 pb-10 lg:px-6 lg:pt-13 lg:pb-11">
    <Eyebrow>{eyebrow}</Eyebrow>
    <h1 class="mt-3 font-display text-h1 leading-[1.2] lg:leading-(--text-h1--line-height)">{title}</h1>
    <p class="mt-3 max-w-[560px] text-[0.9375rem] leading-[1.4] whitespace-pre-line lg:text-[0.875rem]">{body}</p>
    <div class="mt-12 lg:mt-12">
      <Button href={cta.href}>{cta.label}</Button>
    </div>
  </div>
  <div class="relative h-[560px] overflow-hidden lg:h-[720px]">
    <Media src={image} alt="Circles members spending time together" eager />
  </div>
</section>
