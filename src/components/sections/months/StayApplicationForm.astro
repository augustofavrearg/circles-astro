---
import { IconChevronDown } from "@tabler/icons-react";
import type { StayForm } from "@/domain/content";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Media from "@/components/ui/Media.astro";
import { InteractiveButton } from "@/components/ui/InteractiveButton";

type Props = StayForm & { id: string; roomTypes: string[]; variant?: "light" | "red" };
const { id, eyebrow, title, subtitle, image, roomTypes, variant = "light" } = Astro.props;
const field = "flex min-h-16 flex-col lg:min-h-12 lg:py-2 lg:text-[0.8125rem] justify-center rounded-lg bg-black/8 px-4 py-2.5 text-[0.9375rem] leading-[1.4]";
const control = "w-full bg-transparent text-black/45 placeholder:text-black/45 disabled:cursor-not-allowed";
---

<!--
  Figma "Start your stay here" (white at the top of the page, red further down).
  Where applications go is not decided yet and Circles does not store personal data itself,
  so the form is rendered disabled instead of faking a submission.
-->
<section id={id} class:list={["px-4 py-12 lg:grid lg:grid-cols-[515px_minmax(0,454px)] lg:justify-between lg:gap-x-12 lg:px-6 lg:py-5", variant === "red" && "bg-red"]}>
  <div class="lg:pt-6">
  <Eyebrow class="text-[1.125rem] lg:text-[0.9375rem]">{eyebrow}</Eyebrow>
  <h2 class="mt-7 max-w-[340px] font-display text-[2.25rem] leading-[1.3] uppercase lg:mt-10 lg:text-[3rem] lg:leading-[1.15]">{title}</h2>
  <p class="mt-1 font-display text-[1.125rem] leading-[1.3] lg:text-[0.9375rem]">{subtitle}</p>

  <form class="mt-20 grid gap-3 lg:mt-11" aria-describedby={`${id}-note`}>
    <label class={field}>
      Full Name
      <input type="text" name="name" autocomplete="name" placeholder="Enter here..." disabled class={control} />
    </label>
    <label class={field}>
      WhatsApp*
      <input type="tel" name="whatsapp" autocomplete="tel" placeholder="@" disabled class={control} />
    </label>
    <div class="grid grid-cols-2 gap-px">
      <label class={`${field} rounded-r-none`}>
        Start of Stay Date
        <span class="flex items-center gap-2">
          <input type="text" name="start" placeholder="Choose" disabled class={control} />
          <IconChevronDown size={16} stroke={1.5} aria-hidden="true" className="shrink-0" />
        </span>
      </label>
      <label class={`${field} rounded-l-none`}>
        End of Stay Date
        <span class="flex items-center gap-2">
          <input type="text" name="end" placeholder="Choose" disabled class={control} />
          <IconChevronDown size={16} stroke={1.5} aria-hidden="true" className="shrink-0" />
        </span>
      </label>
    </div>
    <label class={field}>
      Email Address*
      <input type="email" name="email" autocomplete="email" placeholder="Enter here..." disabled class={control} />
    </label>
    <label class={field}>
      Select a Room Type*
      <span class="relative flex items-center">
        <select name="room" disabled class={`${control} appearance-none pr-6`}>
          <option value="">Choose</option>
          {roomTypes.map((room) => <option>{room}</option>)}
        </select>
        <IconChevronDown size={16} stroke={1.5} aria-hidden="true" className="pointer-events-none absolute right-0" />
      </span>
    </label>
    <div class="mt-2 flex items-center justify-between gap-4">
      <p class="text-detail">Fields marked with * are mandatory</p>
      <InteractiveButton type="submit" disabled className="inline-flex h-10 min-w-47 items-center justify-center rounded-full bg-black px-6 text-cta text-white">
        Submit
      </InteractiveButton>
    </div>
    <p id={`${id}-note`} class="sr-only">Applications open once the form provider is connected.</p>
  </form>
  </div>

  <div class="relative mt-9 aspect-[455/802] overflow-hidden lg:mt-0 lg:aspect-[454/588]">
    <Media src={image} alt="A Circles House bedroom with mountain views" />
  </div>
</section>
