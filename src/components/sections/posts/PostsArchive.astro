---
import type { PostsPage } from "@/domain/content";
import Media from "@/components/ui/Media.astro";

type Props = { postsPage: PostsPage };
const { postsPage } = Astro.props;
const archiveHref = (category?: string, page = 1) => {
  const params = new URLSearchParams();
  if (category) params.set("category", category);
  if (page > 1) params.set("page", String(page));
  const query = params.toString();
  return query ? `/posts?${query}` : "/posts";
};
const pageHref = (page: number) => archiveHref(postsPage.activeCategory?.slug, page);
const visibleCategories = postsPage.categories.filter((category) =>
  category.postCount > 0 || category.slug === postsPage.activeCategory?.slug);
---

<section aria-labelledby="posts-title" class="pb-28">
  <header class="border-b border-black/15 px-4 pb-14 pt-20 lg:px-6 lg:pb-20 lg:pt-28">
    <div class="mx-auto grid max-w-[1500px] gap-10 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-end">
      <div>
        <p class="text-detail uppercase tracking-[0.14em]">Ideas, people, places</p>
        <h1 id="posts-title" class="mt-5 max-w-5xl font-display text-[clamp(3.5rem,9vw,8.5rem)] leading-[0.84] tracking-[-0.05em]">
          Posts from<br />inside the circle.
        </h1>
      </div>
      <p class="max-w-sm text-body text-black/65 lg:pb-2">
        Stories about community, new ways of living and working, and the people building what comes next.
      </p>
    </div>
  </header>

  <div class="mx-auto max-w-[1500px] px-4 pt-12 lg:px-6 lg:pt-20">
    {visibleCategories.length > 0 && (
      <nav aria-label="Filter posts by category" class="mb-10 border-b border-black/15 pb-5 lg:mb-14">
        <ul class="flex flex-wrap gap-x-2 gap-y-3">
          <li>
            <a
              href={archiveHref()}
              aria-current={!postsPage.activeCategory ? "page" : undefined}
              class:list={[
                "inline-flex min-h-11 items-center border px-5 text-detail uppercase tracking-[0.12em] transition-colors",
                !postsPage.activeCategory ? "border-black bg-black text-white" : "border-black/20 hover:border-black",
              ]}
            >
              All
            </a>
          </li>
          {visibleCategories.map((category) => (
            <li>
              <a
                href={archiveHref(category.slug)}
                aria-current={postsPage.activeCategory?.slug === category.slug ? "page" : undefined}
                class:list={[
                  "inline-flex min-h-11 items-center border px-5 text-detail uppercase tracking-[0.12em] transition-colors",
                  postsPage.activeCategory?.slug === category.slug
                    ? "border-black bg-black text-white"
                    : "border-black/20 hover:border-black",
                ]}
              >
                {category.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <div class="mb-8 flex items-center justify-between border-b border-black/15 pb-4 text-detail uppercase tracking-[0.12em]">
      <span>{postsPage.activeCategory ? `${postsPage.activeCategory.label} posts` : "Latest posts"}</span>
      <span>{postsPage.total} {postsPage.total === 1 ? "story" : "stories"}</span>
    </div>

    {postsPage.items.length ? (
      <div class="grid gap-x-5 gap-y-14 md:grid-cols-2 lg:grid-cols-3 lg:gap-y-20">
        {postsPage.items.map((post, index) => (
          <article class="group">
            <a href={post.href} class="block">
              <div class:list={["relative overflow-hidden bg-paper", index % 5 === 0 ? "aspect-[4/5]" : "aspect-[4/3]"]}>
                <Media
                  src={post.image}
                  alt={post.imageAlt ?? ""}
                  sizes="(min-width: 1024px) 31vw, (min-width: 768px) 50vw, 100vw"
                  placeholderTone={index % 2 === 0 ? "yellow" : "blue"}
                  imageClass="transition-transform duration-700 group-hover:scale-[1.035]"
                />
                <span class="absolute left-3 top-3 bg-background px-3 py-1 text-detail">{post.category}</span>
              </div>
              <div class="pt-5">
                <p class="text-detail text-black/50">{post.date}{post.minutesToRead ? ` · ${post.minutesToRead} min read` : ""}</p>
                <h2 class="mt-3 font-display text-[clamp(1.75rem,2.7vw,2.75rem)] leading-[1.02] tracking-[-0.025em] transition-opacity group-hover:opacity-60">
                  {post.title}
                </h2>
                <p class="mt-4 line-clamp-3 max-w-xl text-body text-black/65">{post.excerpt}</p>
              </div>
            </a>
          </article>
        ))}
      </div>
    ) : (
      <p class="py-24 text-center font-display text-h4">
        {postsPage.activeCategory
          ? `No ${postsPage.activeCategory.label.toLowerCase()} posts have been published yet.`
          : "No posts have been published yet."}
      </p>
    )}

    {postsPage.pageCount > 1 && (
      <nav aria-label="Posts pagination" class="mt-20 flex items-center justify-center gap-3 border-t border-black/15 pt-8">
        {postsPage.page > 1 && <a class="px-4 py-3 text-cta underline underline-offset-4" href={pageHref(postsPage.page - 1)}>Previous</a>}
        <span class="px-4 py-3 text-detail">Page {postsPage.page} of {postsPage.pageCount}</span>
        {postsPage.page < postsPage.pageCount && <a class="px-4 py-3 text-cta underline underline-offset-4" href={pageHref(postsPage.page + 1)}>Next</a>}
      </nav>
    )}
  </div>
</section>
