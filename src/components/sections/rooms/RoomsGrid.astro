---
import type { Room } from "@/domain/booking";
import type { RoomsPage, SearchLocation } from "@/domain/content";
import Button from "@/components/ui/Button.astro";
import RoomCard from "@/components/sections/shared/RoomCard.astro";
import { routes } from "@/config/navigation";

type Props = {
  rooms: { room: Room; bookingHref: string }[];
  locationLabel: string;
  locations: SearchLocation[];
  selectedLocation: string;
  empty: RoomsPage["empty"];
};

const { rooms, locationLabel, locations, selectedLocation, empty } = Astro.props;
---

<section aria-labelledby="rooms-heading" class="px-4 pb-24 lg:px-6 lg:pb-36">
  <nav aria-label="Select a Circles House location" class="mb-8 inline-flex max-w-full flex-wrap rounded-lg bg-black/8 p-0.5 lg:mb-12">
    {locations.map((location) => location.comingSoon ? (
      <span aria-disabled="true" class="flex h-8 min-w-28 items-center justify-center gap-2 rounded-md px-4 text-detail text-black/35">
        {location.city}
        <span class="text-[0.625rem] uppercase">Soon</span>
      </span>
    ) : (
      <a
        href={routes.cityRooms(location.slug)}
        aria-current={location.slug === selectedLocation ? "page" : undefined}
        class:list={[
          "flex h-8 min-w-28 items-center justify-center rounded-md px-4 text-detail transition-colors",
          location.slug === selectedLocation ? "bg-black text-white" : "text-black/45 hover:text-black",
        ]}
      >
        {location.city}
      </a>
    ))}
  </nav>

  <header class="flex items-end justify-between gap-6 border-b border-black/12 pb-4">
    <div>
      <p class="text-detail uppercase text-black/50">Available rooms</p>
      <h2 id="rooms-heading" class="mt-1 font-display text-[2rem] leading-[1.15] lg:text-[2.5rem]">{locationLabel}</h2>
    </div>
    <p class="shrink-0 text-detail uppercase">{rooms.length} {rooms.length === 1 ? "room" : "rooms"}</p>
  </header>

  {rooms.length > 0 ? (
    <div class="grid gap-x-3 gap-y-12 pt-8 lg:grid-cols-2 lg:gap-y-16 lg:pt-12">
      {rooms.map(({ room, bookingHref }, index) => (
        <RoomCard
          {room}
          {bookingHref}
          buttonLabel="Check availability"
          placeholderTone={index % 2 === 0 ? "yellow" : "blue"}
        />
      ))}
    </div>
  ) : (
    <div class="flex min-h-[420px] flex-col items-center justify-center border-b border-black/12 px-4 py-20 text-center">
      <h2 class="max-w-[720px] font-display text-h2">{empty.title}</h2>
      <p class="mt-5 max-w-[520px] text-[0.9375rem] leading-[1.45]">{empty.body}</p>
      <Button href={empty.cta.href} class="mt-8">{empty.cta.label}</Button>
    </div>
  )}
</section>
