---
import type { RoomsPage, SearchLocation } from "@/domain/content";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import { BookingSearch } from "@/islands/BookingSearch";

type Props = RoomsPage["intro"] & {
  locations: SearchLocation[];
  initialLocation?: string;
  initialCheckIn?: string;
  initialCheckOut?: string;
  initialGuests?: string;
};

const {
  eyebrow,
  title,
  body,
  locations,
  initialLocation,
  initialCheckIn,
  initialCheckOut,
  initialGuests,
} = Astro.props;
---

<section class="px-4 pt-14 pb-12 lg:px-6 lg:pt-24 lg:pb-16">
  <div class="grid gap-8 border-b border-black/12 pb-12 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:pb-16">
    <Eyebrow>{eyebrow}</Eyebrow>
    <div>
      <h1 class="max-w-[820px] text-balance font-display text-h1 uppercase">{title}</h1>
      <p class="mt-6 max-w-[620px] text-[0.9375rem] leading-[1.45] lg:text-[0.875rem]">{body}</p>
    </div>
  </div>

  <BookingSearch
    client:load
    {locations}
    {initialLocation}
    {initialCheckIn}
    {initialCheckOut}
    {initialGuests}
    className="mt-8 lg:mx-auto lg:mt-12"
  />
</section>
