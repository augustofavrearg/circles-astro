---
import type { CtaBand } from "@/domain/content";
import Button from "@/components/ui/Button.astro";
import { cn } from "@/lib/cn";

/** `compact`: the shorter band used on For Investors and Team. */
type Props = CtaBand & { text?: string; compact?: boolean; class?: string };
const { title, primaryCta, secondaryCta, text, compact = false, class: className } = Astro.props;
---

<!-- Figma: yellow band (Partnerships, For Investors) — title on top, the members' discount and two actions at the bottom. -->
<section class={cn("mt-24 px-4 lg:mt-44 lg:px-6", className)}>
  <div class:list={["flex flex-col bg-yellow p-6", compact ? "lg:min-h-[205px]" : "lg:min-h-[272px]"]}>
    <h2 class="font-display text-h1 leading-[1.25] lg:leading-[1.15]">{title}</h2>
    <div class="mt-12 lg:mt-auto lg:flex lg:items-end lg:justify-between lg:gap-8">
      {text && <p class="font-display text-[1.125rem] leading-[1.2] lg:text-[1rem]">{text}</p>}
      {(primaryCta || secondaryCta) && (
        <div class="mt-6 flex flex-col gap-3 min-[360px]:flex-row lg:mt-0 lg:shrink-0 lg:gap-2">
          {secondaryCta && <Button href={secondaryCta.href} variant="secondary" class="max-[359px]:w-full">{secondaryCta.label}</Button>}
          {primaryCta && <Button href={primaryCta.href} class="max-[359px]:w-full">{primaryCta.label}</Button>}
        </div>
      )}
    </div>
  </div>
</section>
