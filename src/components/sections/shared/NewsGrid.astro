---
import type { HomePage } from "@/domain/content";
import Media from "@/components/ui/Media.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import { ScrollButtons } from "@/islands/ScrollButtons";

type Props = HomePage["news"];
const { eyebrow, title, items } = Astro.props;
---

<section id="news" class="pt-24 lg:pt-28">
  <SectionHeading {eyebrow} {title} />
  <!-- Figma shows the arrows on mobile only. -->
  <div class="mt-10 flex justify-center lg:hidden">
    <ScrollButtons client:visible targetId="news-track" label="announcements" />
  </div>
  <div id="news-track" class="scrollbar-none mt-12 flex snap-x scroll-px-4 gap-4 overflow-x-auto px-4 lg:mt-20 lg:scroll-px-6 lg:gap-12 lg:px-6">
    {items.map((item) => (
      <a href={item.href} class="group w-[389px] max-w-[calc(100vw-3rem)] shrink-0 snap-start lg:w-[540px] lg:max-w-none">
        <div class="relative h-[388px] overflow-hidden">
          <Media src={item.image} alt="" imageClass="transition-transform duration-700 group-hover:scale-105" />
          <span class="absolute top-4 left-4 rounded bg-black/45 px-4 py-1 text-detail text-white">{item.category}</span>
        </div>
        <div class="px-4">
          <p class="mt-7 text-detail text-black/50">{item.date}</p>
          <h3 class="mt-5 font-display text-[2.25rem] leading-[1.17]">{item.title}</h3>
          <p class="mt-3 line-clamp-2 text-body">{item.excerpt}</p>
        </div>
      </a>
    ))}
  </div>
</section>
