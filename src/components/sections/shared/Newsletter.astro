---
import { IconArrowNarrowRight } from "@tabler/icons-react";
import { cn } from "@/lib/cn";

type Props = { description: string; copy?: Record<string, string>; class?: string };
const { description, copy = {}, class: className } = Astro.props;
const title = copy["newsletter.title"] ?? "Join our Newsletter";
const placeholder = copy["newsletter.emailPlaceholder"] ?? "Enter your email";
const note = copy["newsletter.disabled"] ?? "Subscriptions will open once the email provider and consent text are approved.";
---

<section class={cn("mt-28 px-4 lg:px-6", className)}>
  <div class="grid gap-16 bg-black p-6 text-white lg:min-h-[220px] lg:grid-cols-[minmax(0,1fr)_510px] lg:grid-rows-[1fr_auto] lg:gap-x-12 lg:gap-y-10">
    <h2 class="font-display text-[4rem] leading-none lg:col-start-1">{title}</h2>
    <p class="font-display text-[1.25rem] leading-[1.1] lg:col-start-1 lg:row-start-2 lg:max-w-[680px]">{description}</p>
    <!-- No email provider is connected yet, so the field stays disabled instead of faking a subscription. -->
    <form class="-mt-6 lg:col-start-2 lg:row-start-2 lg:mt-0 lg:self-end" aria-describedby="newsletter-note">
      <label for="newsletter-email" class="sr-only">Email</label>
      <div class="flex items-center gap-3 border-b border-white pb-3 lg:pb-2">
        <input
          id="newsletter-email"
          type="email"
          name="email"
          autocomplete="email"
          placeholder={placeholder}
          disabled
          class="min-w-0 flex-1 bg-transparent text-[0.9375rem] text-white placeholder:text-white disabled:cursor-not-allowed"
        />
        <!-- Figma desktop shows a submit arrow; it stays disabled until the provider is connected. -->
        <button type="submit" disabled aria-label="Subscribe" class="hidden h-7 w-12 shrink-0 items-center justify-center rounded-full bg-white text-black disabled:cursor-not-allowed lg:flex">
          <IconArrowNarrowRight size={16} stroke={1.5} />
        </button>
      </div>
      <p id="newsletter-note" class="sr-only">{note}</p>
    </form>
  </div>
</section>
