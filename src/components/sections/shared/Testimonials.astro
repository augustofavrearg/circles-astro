---
import { IconArrowUpRight } from "@tabler/icons-react";
import type { Testimonial } from "@/domain/content";
const { testimonials } = Astro.props as { testimonials: Testimonial[] };
---

<section aria-label="Guest reviews" class="scrollbar-none flex snap-x scroll-px-4 overflow-x-auto px-4 pt-28 pb-20 lg:scroll-px-6 lg:px-6 lg:pt-24 lg:pb-40">
  {testimonials.map((testimonial) => (
    <figure class="flex min-h-[272px] w-[313px] shrink-0 snap-start flex-col border-r border-black/12 pr-6 not-first:pl-12 box-content lg:w-[405px]">
      <blockquote class="line-clamp-4 font-display text-[1.25rem] leading-[1.1]">{testimonial.quote}</blockquote>
      <figcaption class="mt-auto flex items-center gap-4 pt-10">
        <div class="min-w-0 flex-1 text-[0.9375rem] leading-[1.45]">
          <p>{testimonial.author}</p>
          <p class="text-black/50">{testimonial.source}</p>
        </div>
        {testimonial.href && (
          <a href={testimonial.href} target="_blank" rel="noreferrer" aria-label={`Read ${testimonial.author}'s review`} class="flex h-8 w-12 shrink-0 items-center justify-center rounded-full bg-black text-white">
            <IconArrowUpRight size={14} stroke={1.75} />
          </a>
        )}
      </figcaption>
    </figure>
  ))}
</section>
