---
import type { TeamMember } from "@/domain/content";
import Eyebrow from "@/components/ui/Eyebrow.astro";

type Props = { eyebrow?: string; title?: string; members: TeamMember[] };
const { eyebrow, title, members } = Astro.props;
---

<!-- Figma "Meet the founders": centered heading, then centered cards (three columns on desktop, one on mobile). -->
<section class="pt-34 lg:pt-28">
  {(eyebrow || title) && (
    <header class="px-4 text-center lg:px-6">
      {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
      {title && <h2 class:list={["font-display text-h2", eyebrow && "mt-3"]}>{title}</h2>}
    </header>
  )}
  <ul
    aria-label={eyebrow || title || "Circles House team"}
    class:list={[
      "grid gap-y-14 px-4 lg:grid-cols-3 lg:gap-y-12 lg:px-6",
      eyebrow || title ? "mt-26 lg:mt-22" : "lg:mt-0",
    ]}
  >
    {members.map((member) => (
      <li class="flex flex-col items-center text-center">
        <div class="size-[134px] bg-black/8 lg:size-[117px]">
          {member.photo && <img src={member.photo} alt={member.name} loading="lazy" class="size-full object-cover grayscale" />}
        </div>
        <h3 class="mt-2 font-display text-[2.25rem] leading-[1.2] lg:mt-1 lg:text-[2rem]">{member.name}</h3>
        <p class="mt-1 text-[0.9375rem] text-red lg:text-[0.875rem]">{member.role}</p>
        {member.href && (
          <a href={member.href} class="mt-5 text-[0.9375rem] hover:underline lg:mt-4 lg:text-[0.875rem]">
            Learn more<span class="sr-only"> about {member.name}</span>
          </a>
        )}
      </li>
    ))}
  </ul>
</section>
