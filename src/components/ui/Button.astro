---
import { cn } from "@/lib/cn";

type Props = {
  href?: string;
  variant?: "primary" | "secondary" | "simple" | "large";
  class?: string;
  target?: string;
  rel?: string;
};

const { href, variant = "primary", class: className, target, rel } = Astro.props;
const variants = {
  primary: "h-10 min-w-37 rounded-full bg-black px-6 text-cta text-white",
  secondary: "h-10 min-w-37 rounded-full border border-black px-6 text-cta text-black",
  simple: "text-cta text-black",
  large: "font-display text-h3 text-black",
};
const classes = cn(
  "group inline-flex shrink-0 items-center justify-center whitespace-nowrap text-center transition-transform duration-200 hover:-translate-y-0.5",
  variants[variant],
  className,
);
---

{href ? (
  <a href={href} target={target} rel={rel} class={classes}><span class="group-hover:font-semibold"><slot /></span></a>
) : (
  <button type="button" class={classes}><span class="group-hover:font-semibold"><slot /></span></button>
)}
