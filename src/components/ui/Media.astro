---
import { cn } from "@/lib/cn";
import { wixImageSrcSet, wixImageUrl } from "@/lib/wix-image";
import {
  mediaPlaceholderClass,
  USE_MEDIA_PLACEHOLDERS,
  type MediaPlaceholderTone,
} from "@/config/media";

type Props = {
  src?: string;
  alt?: string;
  overlay?: boolean;
  eager?: boolean;
  class?: string;
  imageClass?: string;
  placeholderTone?: MediaPlaceholderTone;
  forceImage?: boolean;
  sizes?: string;
};

const {
  src,
  alt = "",
  overlay = false,
  eager = false,
  class: className,
  imageClass,
  placeholderTone = "yellow",
  forceImage = false,
  sizes = "100vw",
} = Astro.props;
const showPlaceholder = !src || (USE_MEDIA_PLACEHOLDERS && !forceImage);
const optimizedSrc = wixImageUrl(src, 1280);
const srcset = wixImageSrcSet(src);
---

<div class={cn("absolute inset-0 overflow-hidden bg-black/8", className)}>
  {showPlaceholder ? (
    <div aria-hidden="true" class={cn("size-full", mediaPlaceholderClass(placeholderTone))}></div>
  ) : (
    <img
      src={optimizedSrc}
      srcset={srcset}
      sizes={srcset ? sizes : undefined}
      alt={alt}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : "auto"}
      decoding="async"
      class={cn("size-full object-cover", imageClass)}
    />
  )}
  {overlay && <div aria-hidden="true" class="absolute inset-0 bg-linear-to-b from-black/0 to-black/55"></div>}
</div>
