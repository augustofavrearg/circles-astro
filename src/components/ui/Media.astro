---
import { cn } from "@/lib/cn";
import {
  mediaPlaceholderClass,
  USE_MEDIA_PLACEHOLDERS,
  type MediaPlaceholderTone,
} from "@/config/media";

type Props = {
  src?: string;
  alt?: string;
  overlay?: boolean;
  eager?: boolean;
  class?: string;
  imageClass?: string;
  placeholderTone?: MediaPlaceholderTone;
};

const {
  src,
  alt = "",
  overlay = false,
  eager = false,
  class: className,
  imageClass,
  placeholderTone = "yellow",
} = Astro.props;
const showPlaceholder = USE_MEDIA_PLACEHOLDERS || !src;
---

<div class={cn("absolute inset-0 overflow-hidden bg-black/8", className)}>
  {showPlaceholder ? (
    <div aria-hidden="true" class={cn("size-full", mediaPlaceholderClass(placeholderTone))}></div>
  ) : (
    <img
      src={src}
      alt={alt}
      loading={eager ? "eager" : "lazy"}
      decoding="async"
      class={cn("size-full object-cover", imageClass)}
    />
  )}
  {overlay && <div aria-hidden="true" class="absolute inset-0 bg-linear-to-b from-black/0 to-black/55"></div>}
</div>
