---
import type { FaqBlock } from "@/domain/content";

type Props = { blocks: FaqBlock[] };
const { blocks } = Astro.props;
---

<div class="space-y-6 text-body">
  {blocks.map((block) =>
    block.type === "paragraph" ? (
      <p class="whitespace-pre-line">{block.text}</p>
    ) : (
      <ul class="list-disc space-y-2 pl-6">
        {block.items.map((item) => <li>{item}</li>)}
      </ul>
    ),
  )}
</div>
