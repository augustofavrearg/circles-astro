---
import { cn } from "@/lib/cn";
import Eyebrow from "./Eyebrow.astro";

type Props = { eyebrow?: string; title: string; class?: string };
const { eyebrow, title, class: className } = Astro.props;
---
<header class={cn("flex min-w-0 flex-col gap-3 px-4 lg:px-6", className)}>
  {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
  <h2 class="max-w-[820px] font-display text-h2 text-balance">{title}</h2>
</header>
