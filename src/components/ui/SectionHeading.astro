---
import { cn } from "@/lib/cn";
import Eyebrow from "./Eyebrow.astro";

type Props = { eyebrow?: string; title: string; class?: string };
const { eyebrow, title, class: className } = Astro.props;
---
<header class={cn("flex min-w-0 flex-col items-center gap-3 px-4 text-center lg:items-start lg:px-6 lg:text-left", className)}>
  {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
  <h2 class="max-w-[820px] font-display text-h2">{title}</h2>
</header>
