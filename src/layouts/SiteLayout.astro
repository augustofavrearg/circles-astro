---
import type { SiteSettings } from "@/domain/content";
import { siteNavigation } from "@/config/navigation";
import { getCanonicalUrl, getRobotsDirective, getSeoPolicy } from "@/config/seo";
import { HeaderMenu } from "@/islands/HeaderMenu";
import Footer from "@/components/layout/Footer.astro";
import "@/styles/global.css";

type Props = {
  settings: SiteSettings;
  title?: string;
  description?: string;
  noindex?: boolean;
  useWixSeo?: boolean;
};

const {
  settings,
  title = "Circles House",
  description = "The coliving and coworking community designed for entrepreneurs and innovators.",
  noindex = false,
  useWixSeo = false,
} = Astro.props;
const currentPath = Astro.url.pathname;
const currentLocation = `${Astro.url.pathname}${Astro.url.search}`;
const seoPolicy = getSeoPolicy(import.meta.env, Astro.url);
const robotsDirective = getRobotsDirective(seoPolicy, noindex);
const canonicalUrl = noindex ? undefined : getCanonicalUrl(seoPolicy, currentPath);
const navigation = settings.navigation ?? siteNavigation;
const hasWixSeoTags = useWixSeo;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    {!hasWixSeoTags && <meta name="description" content={description} />}
    {!hasWixSeoTags && <meta name="robots" content={robotsDirective} />}
    {!hasWixSeoTags && canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    {!hasWixSeoTags && <title>{title}</title>}
    <slot name="seo-tags" />
  </head>
  <body id="top">
    {settings.promotion && (
      <div class="bg-red px-4 py-1.5 text-center text-detail text-black">
        {settings.promotion}
      </div>
    )}
    <HeaderMenu client:load navigation={navigation.header} currentPath={currentLocation} />
    <main><slot /></main>
    <Footer navigation={navigation.footer} footerImage={settings.footer.image} contact={settings.contact} socials={settings.socials} currentPath={currentLocation} />
  </body>
</html>
