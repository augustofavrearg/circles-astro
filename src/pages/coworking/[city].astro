---
import SiteLayout from "@/layouts/SiteLayout.astro";
import CoworkingPricing from "@/components/sections/coworking/CoworkingPricing.astro";
import MemberDiscounts from "@/components/sections/shared/MemberDiscounts.astro";
import Faq from "@/components/sections/shared/Faq.astro";
import Newsletter from "@/components/sections/shared/Newsletter.astro";
import Button from "@/components/ui/Button.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Media from "@/components/ui/Media.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import { CoworkingSpaces } from "@/islands/CoworkingSpaces";
import { EventsFilter } from "@/islands/EventsFilter";
import { getContentRepository } from "@/services/content/repository";

const repository = await getContentRepository();
const page = await repository.getCoworkingPage(Astro.params.city ?? "");
if (!page) return new Response("Not found", { status: 404 });

// "Happening now" reuses the home events and newsletter copy for now.
const [settings, home] = await Promise.all([repository.getSiteSettings(), repository.getHomePage()]);
const { happeningNow } = home;
---

<SiteLayout settings={settings} title={page.seo.title} description={page.seo.description}>
  <!-- Figma "Coworking - Barcelona": heading, then a full-bleed photo. -->
  <section class="px-4 pt-7 pb-14 lg:px-6 lg:pt-7 lg:pb-14">
    <Eyebrow>{page.hero.eyebrow}</Eyebrow>
    <h1 class="mt-2 font-display text-h1 leading-[1.2] lg:leading-(--text-h1--line-height)">{page.hero.title}</h1>
    <p class="mt-3 text-[0.9375rem] leading-[1.4] lg:text-[0.8125rem]">{page.hero.subtitle}</p>
  </section>
  <div class="relative h-[520px] overflow-hidden lg:h-[765px]">
    <Media src={page.hero.image} alt="Coworking room with views of the trees" eager />
  </div>

  <CoworkingSpaces client:visible {...page.spaces} />
  <CoworkingPricing {...page.pricing} />

  {happeningNow.events.length > 0 && (
    <section class="pt-28">
      <div class="flex items-end justify-between gap-4 lg:pr-6">
        <SectionHeading eyebrow={happeningNow.eyebrow} title={happeningNow.title} class="w-full lg:w-auto" />
        <Button href="/events" variant="secondary" class="hidden lg:inline-flex">{happeningNow.viewAll.label}</Button>
      </div>
      <div class="mt-7">
        <EventsFilter client:visible events={happeningNow.events} cities={happeningNow.cities} />
      </div>
    </section>
  )}

  <MemberDiscounts {...page.band} text={settings.promotion} compact class="lg:mt-16" />
  <Faq {...page.faq} centered uppercase={false} />
  <Newsletter description={home.newsletter.description} copy={settings.interfaceCopy} class="mt-12" />
</SiteLayout>
