---
import SiteLayout from "@/layouts/SiteLayout.astro";
import Button from "@/components/ui/Button.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Media from "@/components/ui/Media.astro";
import { BookingSearch } from "@/islands/BookingSearch";
import { getContentRepository } from "@/services/content/repository";

const repository = await getContentRepository();
const [settings, home] = await Promise.all([repository.getSiteSettings(), repository.getHomePage()]);
---

<SiteLayout settings={settings} title="Design system · Circles House" noindex>
  <div class="px-4 py-16 lg:px-6">
    <Eyebrow>Internal reference</Eyebrow>
    <h1 class="mt-4 font-display text-h1">Circles House<br /><span class="text-red">design system</span></h1>

    <section class="mt-20 border-t border-black/12 pt-6">
      <Eyebrow>Typography</Eyebrow>
      <div class="mt-8 grid gap-8">
        <p class="font-display text-h1">Display One</p>
        <p class="font-display text-h2">Display Two</p>
        <p class="max-w-xl text-body">Body copy remains compact and calm, allowing the oversized display type and photography to carry the emotional weight.</p>
      </div>
    </section>

    <section class="mt-20 border-t border-black/12 pt-6">
      <Eyebrow>Actions</Eyebrow>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="/rooms">Primary action</Button>
        <Button href="/" variant="secondary">Secondary action</Button>
        <Button href="/" variant="simple">Simple action</Button>
      </div>
    </section>

    <section class="mt-20 border-t border-black/12 pt-6">
      <Eyebrow>Booking island</Eyebrow>
      <div class="mt-8 max-w-2xl"><BookingSearch client:load locations={home.searchLocations} /></div>
    </section>

    <section class="mt-20 border-t border-black/12 pt-6">
      <Eyebrow>Media</Eyebrow>
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        {home.news.items.map((item) => (
          <div class="relative h-[380px] overflow-hidden"><Media src={item.image} alt={item.title} /></div>
        ))}
      </div>
    </section>
  </div>
</SiteLayout>
