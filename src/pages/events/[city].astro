---
import SiteLayout from "@/layouts/SiteLayout.astro";
import EventsListing from "@/components/sections/events/EventsListing.astro";
import HappeningNavigation from "@/components/sections/events/HappeningNavigation.astro";
import Newsletter from "@/components/sections/shared/Newsletter.astro";
import { getContentRepository } from "@/services/content/repository";

const repository = await getContentRepository();
const page = await repository.getEventsPage();
const city = page.cities.find((item) => item.slug === Astro.params.city);
if (!city) return new Response("Not found", { status: 404 });

const [settings, events] = await Promise.all([repository.getSiteSettings(), repository.getEvents(city.slug)]);
---

<SiteLayout settings={settings} title={`Events in ${city.name} · Circles House`} description={page.subtitle}>
  <HappeningNavigation navigation={settings.navigation?.header} cities={page.cities} currentPath={Astro.url.pathname} kind="events" />
  <EventsListing {page} {events} city={city.slug} />
  <Newsletter newsletter={settings.newsletter} copy={settings.interfaceCopy} class="mt-12 lg:mt-10" />
</SiteLayout>
