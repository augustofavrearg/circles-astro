---
import SiteLayout from "@/layouts/SiteLayout.astro";
import EventsListing from "@/components/sections/EventsListing.astro";
import Newsletter from "@/components/sections/Newsletter.astro";
import { getContentRepository } from "@/services/content/repository";

const repository = await getContentRepository();
const page = await repository.getEventsPage();
const city = page.cities.find((item) => item.slug === Astro.params.city);
if (!city) return new Response("Not found", { status: 404 });

// The newsletter copy lives on the home page content for now.
const [settings, events, home] = await Promise.all([repository.getSiteSettings(), repository.getEvents(city.slug), repository.getHomePage()]);
---

<SiteLayout settings={settings} title={`Events in ${city.name} · Circles House`} description={page.subtitle}>
  <EventsListing {page} {events} city={city.slug} />
  <Newsletter description={home.newsletter.description} copy={settings.interfaceCopy} class="mt-12 lg:mt-10" />
</SiteLayout>
