---
import SiteLayout from "@/layouts/SiteLayout.astro";
import Hero from "@/components/sections/home/Hero.astro";
import Memberships from "@/components/sections/home/Memberships.astro";
import Introduction from "@/components/sections/home/Introduction.astro";
import Testimonials from "@/components/sections/shared/Testimonials.astro";
import NewsGrid from "@/components/sections/shared/NewsGrid.astro";
import Newsletter from "@/components/sections/shared/Newsletter.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import { EventsFilter } from "@/islands/EventsFilter";
import { HeroSlider } from "@/islands/HeroSlider";
import { SpacesCarousel } from "@/islands/SpacesCarousel";
import { bookStayLink } from "@/config/navigation";
import { getContentRepository } from "@/services/content/repository";

const repository = await getContentRepository();
const [settings, home] = await Promise.all([repository.getSiteSettings(), repository.getHomePage()]);
---

<SiteLayout settings={settings}>
  <Hero {...home.hero} searchLocations={home.searchLocations} nextSectionId={home.slider.length > 0 ? "locations" : undefined} />

  {home.slider.length > 0 && <HeroSlider client:visible id="locations" slides={home.slider} defaultCta={bookStayLink} />}

  <section id="network" class="py-28">
    <SpacesCarousel client:visible spaces={home.network.spaces} defaultCta={bookStayLink}>
      <SectionHeading eyebrow={home.network.eyebrow} title={home.network.title} />
    </SpacesCarousel>
  </section>

  {home.happeningNow.events.length > 0 && (
    <section id="events" class="py-28">
      <SectionHeading eyebrow={home.happeningNow.eyebrow} title={home.happeningNow.title} />
      <div class="mt-7">
        <EventsFilter client:visible events={home.happeningNow.events} cities={home.happeningNow.cities} />
      </div>
    </section>
  )}

  <Memberships {...home.memberships} />
  <Introduction {...home.introduction} />
  <Testimonials testimonials={home.testimonials} />
  <NewsGrid {...home.news} />
  <Newsletter newsletter={settings.newsletter} copy={settings.interfaceCopy} />
</SiteLayout>
