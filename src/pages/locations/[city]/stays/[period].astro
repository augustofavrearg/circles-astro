---
import SiteLayout from "@/layouts/SiteLayout.astro";
import MonthHero from "@/components/sections/months/MonthHero.astro";
import StayApplicationForm from "@/components/sections/months/StayApplicationForm.astro";
import ExternalEventsCarousel from "@/components/sections/months/ExternalEventsCarousel.astro";
import RoomCard from "@/components/sections/shared/RoomCard.astro";
import EventRow from "@/components/sections/shared/EventRow.astro";
import MemberDiscounts from "@/components/sections/shared/MemberDiscounts.astro";
import Faq from "@/components/sections/shared/Faq.astro";
import Newsletter from "@/components/sections/shared/Newsletter.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import { SpacesCarousel } from "@/islands/SpacesCarousel";
import { bookStayLink } from "@/config/navigation";
import { createCloudbedsProvider } from "@/services/booking/cloudbeds";
import { getContentRepository } from "@/services/content/repository";
import { whatsappLinks } from "@/lib/whatsapp";

const repository = await getContentRepository();
const campaign = await repository.getStayCampaign(Astro.params.city ?? "", Astro.params.period ?? "");
if (!campaign) return new Response("Not found", { status: 404 });
const page = campaign.page;
const [settings, rooms, events] = await Promise.all([
  repository.getSiteSettings(),
  repository.getRooms(campaign.location.slug),
  repository.getEvents({ locations: [campaign.location.slug], month: campaign.period }),
]);
const booking = createCloudbedsProvider(import.meta.env.CLOUDBEDS_ALLOWED_ORIGIN);
const roomTypes = rooms.map((room) => room.name);
---

<SiteLayout settings={settings} title={page.seo.title} description={page.seo.description}>
  <MonthHero {...page.hero} />
  <StayApplicationForm id="apply" {...page.form} {roomTypes} />
  <section class="pt-16">
    <SpacesCarousel client:visible spaces={page.space.spaces} defaultCta={bookStayLink}>
      <SectionHeading eyebrow={page.space.eyebrow} title={page.space.title} class="items-start text-left" />
    </SpacesCarousel>
  </section>
  <section id="rooms" class="scroll-mt-20 px-4 pt-28 lg:px-6">
    <header class="text-center">
      <Eyebrow>{page.rooms.eyebrow}</Eyebrow>
      <h2 class="mt-3 font-display text-[2.375rem] leading-[1.3] uppercase lg:text-h1 lg:leading-(--text-h1--line-height)">{page.rooms.title}</h2>
      <p class="mx-auto mt-3 max-w-[600px] text-[0.9375rem] leading-[1.45] lg:max-w-[540px] lg:text-[0.8125rem]">{page.rooms.text}</p>
    </header>
    <div class="mt-24 grid gap-4 lg:mt-16 lg:grid-cols-2 lg:gap-3">
      {rooms.map((room) => <RoomCard room={room} bookingHref={booking.getRedirect(room).toString()} supportHref={whatsappLinks.flexibleStay} />)}
    </div>
  </section>
  <MemberDiscounts {...page.band} text={settings.promotion} compact class="mt-4 lg:mt-28" />
  <section class="pt-28">
    <SectionHeading eyebrow={page.events.eyebrow} title={page.events.title} class="lg:items-center lg:text-center" />
    {events.length > 0 ? (
      <div class="mt-16 flex flex-col gap-2 px-4 lg:px-6">{events.map((event) => <EventRow event={event} />)}</div>
    ) : (
      <p class="mx-4 mt-16 bg-surface p-6 text-body lg:mx-6">No events are scheduled for this stay period yet.</p>
    )}
  </section>
  {page.external?.items.length ? <ExternalEventsCarousel id="external-events" {...page.external} /> : null}
  <StayApplicationForm id="apply-again" {...page.form} {roomTypes} variant="red" />
  {page.seasonal?.items.length ? <ExternalEventsCarousel id="seasonal-events" {...page.seasonal} /> : null}
  {page.faq?.items.length ? <Faq {...page.faq} centered uppercase={false} /> : null}
  <Newsletter newsletter={settings.newsletter} copy={settings.interfaceCopy} class="mt-12" />
</SiteLayout>
