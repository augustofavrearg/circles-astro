---
import SiteLayout from "@/layouts/SiteLayout.astro";
import MembershipIntro from "@/components/sections/memberships/MembershipIntro.astro";
import MembershipBenefits from "@/components/sections/memberships/MembershipBenefits.astro";
import MemberHub from "@/components/sections/memberships/MemberHub.astro";
import MembershipPricing from "@/components/sections/memberships/MembershipPricing.astro";
import MembersCarousel from "@/components/sections/memberships/MembersCarousel.astro";
import MemberDiscounts from "@/components/sections/shared/MemberDiscounts.astro";
import Faq from "@/components/sections/shared/Faq.astro";
import Newsletter from "@/components/sections/shared/Newsletter.astro";
import { getContentRepository } from "@/services/content/repository";

const repository = await getContentRepository();
// The newsletter copy lives on the home page content for now.
const [settings, page, home] = await Promise.all([repository.getSiteSettings(), repository.getMembershipsPage(), repository.getHomePage()]);
---

<SiteLayout settings={settings} title={page.seo.title} description={page.seo.description}>
  <MembershipIntro {...page.intro} />
  <MembershipBenefits {...page.benefits} />
  <MemberHub {...page.hub} />
  <MembershipPricing {...page.pricing} />
  <MembersCarousel {...page.members} />
  <MemberDiscounts {...page.band} text={settings.promotion} compact class="lg:mt-28" />
  <Faq {...page.faq} centered uppercase={false} />
  <Newsletter description={home.newsletter.description} copy={settings.interfaceCopy} class="mt-12" />
</SiteLayout>
