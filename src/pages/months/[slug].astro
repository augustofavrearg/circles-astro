---
import { routes } from "@/config/navigation";
import { getContentRepository } from "@/services/content/repository";

const repository = await getContentRepository();
const campaign = await repository.getStayCampaignByLegacySlug(Astro.params.slug ?? "");
if (!campaign) return new Response("Not found", { status: 404 });
return Astro.redirect(routes.stayCampaign(campaign.location.slug, campaign.period), 301);
