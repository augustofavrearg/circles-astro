---
import SiteLayout from "@/layouts/SiteLayout.astro";
import NewsGrid from "@/components/sections/NewsGrid.astro";
import { getContentRepository } from "@/services/content/repository";

const repository = await getContentRepository();
const [settings, articles] = await Promise.all([
  repository.getSiteSettings(),
  repository.getNewsArticles(),
]);
---

<SiteLayout settings={settings} title="News · Circles House" description="Latest news and announcements from Circles House.">
  <div class="pb-28">
    <NewsGrid eyebrow="News" title="Latest announcements" items={articles} />
  </div>
</SiteLayout>
