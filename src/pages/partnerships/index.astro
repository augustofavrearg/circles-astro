---
import SiteLayout from "@/layouts/SiteLayout.astro";
import PageIntro from "@/components/sections/shared/PageIntro.astro";
import PartnerList from "@/components/sections/partnerships/PartnerList.astro";
import MemberDiscounts from "@/components/sections/shared/MemberDiscounts.astro";
import Faq from "@/components/sections/shared/Faq.astro";
import Newsletter from "@/components/sections/shared/Newsletter.astro";
import { getContentRepository } from "@/services/content/repository";
import { resolveEditorialSource } from "@/services/content/editorial-sources";

const repository = await getContentRepository();
const [settings, page] = await Promise.all([repository.getSiteSettings(), repository.getPartnershipsPage()]);
const partnerSource = page.partners.source ?? { mode: "automatic", key: "partners.published" } as const;
const resolvedPartners = await resolveEditorialSource(repository, partnerSource, {}, "partners.published");
const partners = resolvedPartners.map((partner) => partner.slug === "barcelona-tech-city"
  ? { ...partner, logo: partner.logo ?? "/images/partnerships/barcelona-tech-city.jpg" }
  : partner);
const intro = {
  ...page.intro,
  // Keep the Figma-approved panorama available when Wix has not received its media copy yet.
  image: page.intro.image ?? "/images/partnerships/barcelona-panorama.png",
};
---

<SiteLayout settings={settings} title={page.seo.title} description={page.seo.description}>
  <PageIntro {intro} imageAlt="Barcelona seen from Circles House" bodyClass="lg:max-w-[580px]" />
  {partners.length > 0 && <PartnerList {...page.partners} items={partners} />}
  {page.membership && <MemberDiscounts {...page.membership} text={settings.promotion} />}
  {page.faq && <Faq {...page.faq} centered />}
  <Newsletter newsletter={settings.newsletter} copy={settings.interfaceCopy} class="mt-12" />
</SiteLayout>
