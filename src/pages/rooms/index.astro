---
import { routes } from "@/config/navigation";
import { getContentRepository } from "@/services/content/repository";

const repository = await getContentRepository();
const locations = await repository.getSearchLocations();
const requestedLocation = Astro.url.searchParams.get("location");
const selectedLocation = locations.find((location) => location.slug === requestedLocation && !location.comingSoon)
  ?? locations.find((location) => !location.comingSoon);
if (!selectedLocation) return new Response("No Circles House locations are available.", { status: 503 });

const params = new URLSearchParams(Astro.url.searchParams);
params.delete("location");
const destination = `${routes.cityRooms(selectedLocation.slug)}${params.size ? `?${params}` : ""}`;
return Astro.redirect(destination, 302);
---
