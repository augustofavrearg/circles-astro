---
import SiteLayout from "@/layouts/SiteLayout.astro";
import PageIntro from "@/components/sections/shared/PageIntro.astro";
import TeamGrid from "@/components/sections/team/TeamGrid.astro";
import MemberDiscounts from "@/components/sections/shared/MemberDiscounts.astro";
import Faq from "@/components/sections/shared/Faq.astro";
import Newsletter from "@/components/sections/shared/Newsletter.astro";
import { getContentRepository } from "@/services/content/repository";

const repository = await getContentRepository();
const [settings, page, members] = await Promise.all([
  repository.getSiteSettings(),
  repository.getTeamPage(),
  repository.getTeamMembers(),
]);
---

<SiteLayout settings={settings} title={page.seo.title} description={page.seo.description}>
  <PageIntro intro={page.intro} imageAlt="Members talking on the Circles House rooftop" bodyClass="lg:max-w-[460px]" />
  {members.length > 0 && <TeamGrid {...page.members} {members} />}
  {page.band && <MemberDiscounts {...page.band} text={settings.promotion} compact class="lg:mt-28" />}
  <!-- Figma Team keeps the questions in sentence case on desktop. -->
  {page.faq && <Faq {...page.faq} centered uppercase={false} />}
  <Newsletter newsletter={settings.newsletter} copy={settings.interfaceCopy} class="mt-12" />
</SiteLayout>
