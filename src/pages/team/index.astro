---
import SiteLayout from "@/layouts/SiteLayout.astro";
import PageIntro from "@/components/sections/PageIntro.astro";
import TeamGrid from "@/components/sections/TeamGrid.astro";
import MemberDiscounts from "@/components/sections/MemberDiscounts.astro";
import Faq from "@/components/sections/Faq.astro";
import Newsletter from "@/components/sections/Newsletter.astro";
import { getContentRepository } from "@/services/content/repository";

const repository = await getContentRepository();
// The newsletter copy lives on the home page content for now.
const [settings, page, members, home] = await Promise.all([
  repository.getSiteSettings(),
  repository.getTeamPage(),
  repository.getTeamMembers(),
  repository.getHomePage(),
]);
---

<SiteLayout settings={settings} title={page.seo.title} description={page.seo.description}>
  <PageIntro intro={page.intro} imageAlt="Members talking on the Circles House rooftop" bodyClass="lg:max-w-[460px]" />
  <TeamGrid {...page.members} {members} />
  <MemberDiscounts {...page.band} text={settings.promotion} compact class="lg:mt-28" />
  <!-- Figma Team keeps the questions in sentence case on desktop. -->
  <Faq {...page.faq} centered uppercase={false} />
  <Newsletter description={home.newsletter.description} class="mt-12" />
</SiteLayout>
