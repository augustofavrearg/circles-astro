---
import SiteLayout from "@/layouts/SiteLayout.astro";
import PageIntro from "@/components/sections/shared/PageIntro.astro";
import PurposeStatement from "@/components/sections/what-is-circles/PurposeStatement.astro";
import ValuesAndEdge from "@/components/sections/what-is-circles/ValuesAndEdge.astro";
import Manifesto from "@/components/sections/what-is-circles/Manifesto.astro";
import Faq from "@/components/sections/shared/Faq.astro";
import Newsletter from "@/components/sections/shared/Newsletter.astro";
import { getContentRepository } from "@/services/content/repository";

const repository = await getContentRepository();
const [settings, page] = await Promise.all([repository.getSiteSettings(), repository.getWhatIsCirclesPage()]);
---

<SiteLayout settings={settings} title={page.seo.title} description={page.seo.description}>
  <PageIntro intro={page.intro} imageAlt="Circles House Barcelona above the city" bodyClass="lg:max-w-[640px]" />
  <PurposeStatement {...page.purpose} />
  <ValuesAndEdge values={page.values} edge={page.edge} />
  <Manifesto {...page.manifesto} />
  <!-- Figma What is Circles keeps the questions in sentence case on desktop. -->
  <Faq {...page.faq} centered uppercase={false} />
  <Newsletter newsletter={settings.newsletter} copy={settings.interfaceCopy} class="mt-12" />
</SiteLayout>
