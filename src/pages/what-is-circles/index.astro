---
import SiteLayout from "@/layouts/SiteLayout.astro";
import PageIntro from "@/components/sections/PageIntro.astro";
import PurposeStatement from "@/components/sections/PurposeStatement.astro";
import ValuesAndEdge from "@/components/sections/ValuesAndEdge.astro";
import Manifesto from "@/components/sections/Manifesto.astro";
import Faq from "@/components/sections/Faq.astro";
import Newsletter from "@/components/sections/Newsletter.astro";
import { getContentRepository } from "@/services/content/repository";

const repository = await getContentRepository();
// The newsletter copy lives on the home page content for now.
const [settings, page, home] = await Promise.all([repository.getSiteSettings(), repository.getWhatIsCirclesPage(), repository.getHomePage()]);
---

<SiteLayout settings={settings} title={page.seo.title} description={page.seo.description}>
  <PageIntro intro={page.intro} imageAlt="Circles House Barcelona above the city" bodyClass="lg:max-w-[640px]" />
  <PurposeStatement {...page.purpose} />
  <ValuesAndEdge values={page.values} edge={page.edge} />
  <Manifesto {...page.manifesto} />
  <!-- Figma What is Circles keeps the questions in sentence case on desktop. -->
  <Faq {...page.faq} centered uppercase={false} />
  <Newsletter description={home.newsletter.description} copy={settings.interfaceCopy} class="mt-12" />
</SiteLayout>
